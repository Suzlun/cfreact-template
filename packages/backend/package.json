{
  "name": "@cfreact-template/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/entry/index.ts",
  "exports": {
    ".": "./src/entry/index.ts",
    "./app": "./src/app/index.ts",
    "./modules/users": "./src/modules/users/index.ts",
    "./modules/hello": "./src/modules/hello/index.ts",
    "./modules/health": "./src/modules/health/index.ts",
    "./types": "./src/types/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "build": "pnpm check",
    "deploy": "wrangler deploy",
    "gen:types": "node ../../scripts/codegen/verify-codegen-roots.mjs && openapi-typescript ../typespec/openapi/openapi.json -o src/generated/api/openapi.ts",
    "gen:api": "pnpm gen:types && node ../../scripts/codegen/verify-codegen-roots.mjs && orval --config ./orval.config.ts && node ../../scripts/codegen/normalize-backend-handler-imports.mjs && prettier --write \"src/generated/api/**/*.ts\" \"src/modules/*/handlers/**/*.ts\"",
    "check": "pnpm check:types",
    "check:types": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/zod-validator": "0.8.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260613.1",
    "openapi-typescript": "7.13.0",
    "orval": "8.17.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.100.0"
  }
}
