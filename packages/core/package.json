{
  "name": "@cfreact-template/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/entry/index.ts",
  "exports": {
    ".": "./src/entry/index.ts",
    "./app": "./src/app/index.ts",
    "./modules/users": "./src/modules/users/index.ts",
    "./types": "./src/types/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "build": "pnpm check",
    "deploy": "wrangler deploy --config wrangler.toml --env production",
    "deploy:dry-run": "wrangler deploy --config wrangler.toml --env production --dry-run",
    "check": "pnpm check:typespec && pnpm check:types",
    "check:typespec": "pnpm format:typespec:check && tsp compile typespec --no-emit",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "format:typespec": "tsp format typespec",
    "format:typespec:check": "tsp format typespec --check",
    "gen:openapi": "node ../../scripts/codegen/verify-codegen-roots.mjs && tsp compile typespec",
    "gen:types": "node ../../scripts/codegen/verify-codegen-roots.mjs && openapi-typescript typespec/openapi/openapi.json -o src/generated/api/openapi.ts",
    "gen:api": "pnpm gen:types && node ../../scripts/codegen/verify-codegen-roots.mjs && orval --config ./orval.config.ts && node ../../scripts/codegen/normalize-backend-handler-imports.mjs --openapi packages/core/typespec/openapi/openapi.json --modules packages/core/src/modules && prettier --write \"src/generated/api/**/*.ts\" \"src/modules/*/handlers/**/*.ts\"",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "0.8.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260613.1",
    "@typespec/compiler": "^1.13.0",
    "@typespec/http": "^1.13.0",
    "@typespec/openapi": "^1.13.0",
    "@typespec/openapi3": "^1.13.0",
    "drizzle-kit": "^0.31.8",
    "openapi-typescript": "7.13.0",
    "orval": "8.17.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.100.0"
  }
}
