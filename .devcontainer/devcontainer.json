{
  "name": "cfreact-template",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "runServices": ["dev", "ai"],
  "workspaceFolder": "/workspaces/project",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.16.0"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "hediet.vscode-drawio",
        "ms-azuretools.vscode-docker",
        "hashicorp.terraform",
        "typespec.typespec-vscode",
        "vitest.explorer",
        "ms-playwright.playwright",
        "usernamehw.errorlens",
        "eamodio.gitlens",
        "christian-kohler.path-intellisense",
        "formulahendry.auto-rename-tag",
        "wix.vscode-import-cost",
        "dsznajder.es7-react-js-snippets",
        "yoavbls.pretty-ts-errors",
        "mikestead.dotenv",
        "typespec.typespec-vscode",
        "openai.chatgpt"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"]
      }
    }
  },
  "forwardPorts": [5173, 6006, 7456, 8787, 24282],
  "portsAttributes": {
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "notify"
    },
    "8787": {
      "label": "Cloudflare Workers Dev",
      "onAutoForward": "notify"
    },
    "6006": {
      "label": "Storybook / React Mock",
      "onAutoForward": "notify"
    },
    "7456": {
      "label": "AI / OpenDesign",
      "onAutoForward": "notify"
    },
    "24282": {
      "label": "Serena Dashboard",
      "onAutoForward": "notify"
    }
  },
  "initializeCommand": "umask 077 && mkdir -p .devcontainer/.volumes/open-design .devcontainer/.volumes/dev-config/opencode .devcontainer/.volumes/opencode-config .devcontainer/.volumes/opencode-data .devcontainer/.volumes/opencode-state && sh .devcontainer/scripts/sync-git-user.sh capture",
  "postCreateCommand": "sh .devcontainer/scripts/install-applications.sh && pnpm install && pnpm exec playwright install",
  "postStartCommand": "sh .devcontainer/scripts/sync-git-user.sh apply && git config --global --add safe.directory ${containerWorkspaceFolder} && node .devcontainer/scripts/register-opendesign.mjs \"${localWorkspaceFolderBasename}\"",
  "remoteUser": "node"
}
