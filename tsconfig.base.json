{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "paths": {
      "@cfreact-template/frontend": ["./packages/frontend/src/app/index.ts"],
      "@cfreact-template/frontend/app": ["./packages/frontend/src/app/index.ts"],
      "@cfreact-template/frontend/app/*": ["./packages/frontend/src/app/*"],
      "@cfreact-template/frontend/domain": ["./packages/frontend/src/domain/index.ts"],
      "@cfreact-template/frontend/domain/*": ["./packages/frontend/src/domain/*"],
      "@cfreact-template/frontend/api": ["./packages/frontend/src/api/index.ts"],
      "@cfreact-template/frontend/api/*": ["./packages/frontend/src/api/*"],
      "@cfreact-template/backend": ["./packages/backend/src/entry/index.ts"],
      "@cfreact-template/backend/app": ["./packages/backend/src/app/index.ts"],
      "@cfreact-template/backend/modules/users": ["./packages/backend/src/modules/users/index.ts"],
      "@cfreact-template/backend/modules/hello": ["./packages/backend/src/modules/hello/index.ts"],
      "@cfreact-template/backend/modules/health": [
        "./packages/backend/src/modules/health/index.ts"
      ],
      "@cfreact-template/backend/types": ["./packages/backend/src/types/index.ts"]
    },
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "exclude": ["node_modules", "dist", "build", ".wrangler"]
}
