{
  "name": "@cfreact-template/main",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/backend/entry/index.ts",
  "exports": {
    ".": "./src/backend/entry/index.ts",
    "./backend": "./src/backend/entry/index.ts",
    "./backend/app": "./src/backend/app/index.ts",
    "./backend/modules/hello": "./src/backend/modules/hello/index.ts",
    "./backend/modules/health": "./src/backend/modules/health/index.ts",
    "./backend/types": "./src/backend/types/index.ts",
    "./frontend": "./src/frontend/app/index.ts",
    "./frontend/app": "./src/frontend/app/index.ts",
    "./frontend/app/app": "./src/frontend/app/app.tsx",
    "./frontend/app/router": "./src/frontend/app/router.tsx",
    "./frontend/app/*": "./src/frontend/app/*",
    "./frontend/api": "./src/frontend/api/index.ts",
    "./frontend/api/api": "./src/frontend/api/api/index.ts",
    "./frontend/api/generated": "./src/frontend/api/generated/client.ts",
    "./frontend/api/sdk": "./src/frontend/api/sdk.ts",
    "./frontend/api/types": "./src/frontend/api/types/index.ts",
    "./frontend/api/*": "./src/frontend/api/*",
    "./frontend/domain": "./src/frontend/domain/index.ts",
    "./frontend/domain/hooks/hello": "./src/frontend/domain/hooks/hello/index.ts",
    "./frontend/domain/hooks/users": "./src/frontend/domain/hooks/users/index.ts",
    "./frontend/domain/providers/QueryProvider": "./src/frontend/domain/providers/QueryProvider.tsx",
    "./frontend/domain/*": "./src/frontend/domain/*"
  },
  "scripts": {
    "dev": "concurrently \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "wrangler dev -c wrangler.toml -c ../../packages/core/wrangler.toml --ip 0.0.0.0",
    "build": "pnpm check && pnpm build:frontend",
    "build:frontend": "vite build",
    "build:backend": "pnpm check:backend",
    "preview": "vite preview",
    "deploy": "wrangler deploy --config wrangler.toml --env production",
    "deploy:dry-run": "wrangler deploy --config wrangler.toml --env production --dry-run",
    "check": "pnpm --filter @cfreact-template/ui check && pnpm check:typespec && pnpm check:frontend && pnpm check:backend",
    "check:typespec": "pnpm format:typespec:check && tsp compile typespec --no-emit",
    "check:frontend": "pnpm check:frontend:api && pnpm check:frontend:domain && pnpm check:frontend:app",
    "check:frontend:api": "tsc --noEmit -p tsconfig.frontend.api.json",
    "check:frontend:domain": "tsc --noEmit -p tsconfig.frontend.domain.json",
    "check:frontend:app": "tsc --noEmit -p tsconfig.frontend.app.json",
    "check:backend": "tsc --noEmit -p tsconfig.backend.json",
    "format:typespec": "tsp format typespec",
    "format:typespec:check": "tsp format typespec --check",
    "gen:openapi": "node ../../scripts/codegen/verify-codegen-roots.mjs && tsp compile typespec",
    "gen:backend:types": "node ../../scripts/codegen/verify-codegen-roots.mjs && openapi-typescript typespec/openapi/openapi.json -o src/backend/generated/api/openapi.ts",
    "gen:backend": "pnpm gen:backend:types && node ../../scripts/codegen/verify-codegen-roots.mjs && orval --config ./orval.backend.config.ts && node ../../scripts/codegen/normalize-backend-handler-imports.mjs --openapi apps/main/typespec/openapi/openapi.json --modules apps/main/src/backend/modules && prettier --write \"src/backend/generated/api/**/*.ts\" \"src/backend/modules/*/handlers/**/*.ts\"",
    "gen:frontend": "node ../../scripts/codegen/verify-codegen-roots.mjs && orval --config ./orval.frontend.config.ts",
    "gen:api": "pnpm gen:openapi && pnpm gen:backend && pnpm gen:frontend",
    "test": "vitest --config vitest.frontend.config.ts",
    "test:frontend": "vitest run --config vitest.frontend.config.ts"
  },
  "dependencies": {
    "@cfreact-template/core-sdk": "workspace:*",
    "@cfreact-template/ui": "workspace:*",
    "@hono/zod-validator": "0.8.0",
    "@tanstack/react-query": "5.101.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "^7.17.0",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cfreact-template/build-config": "workspace:*",
    "@cloudflare/workers-types": "^4.20260613.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typespec/compiler": "^1.13.0",
    "@typespec/http": "^1.13.0",
    "@typespec/openapi": "^1.13.0",
    "@typespec/openapi3": "^1.13.0",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "openapi-typescript": "7.13.0",
    "orval": "8.17.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.100.0"
  }
}
