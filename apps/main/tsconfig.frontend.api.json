{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "./dist/api",
    "paths": {
      "@cfreact-template/core-sdk": ["./src/__forbidden__/core-sdk.ts"],
      "@cfreact-template/main/frontend": ["./src/__forbidden__/frontend.ts"],
      "@cfreact-template/main/frontend/app": ["./src/__forbidden__/app.ts"],
      "@cfreact-template/main/frontend/app/*": ["./src/__forbidden__/app/*"],
      "@cfreact-template/main/frontend/api": ["./src/frontend/api/index.ts"],
      "@cfreact-template/main/frontend/api/generated": ["./src/frontend/api/generated/client.ts"],
      "@cfreact-template/main/frontend/api/types": ["./src/frontend/api/types/index.ts"],
      "@cfreact-template/main/frontend/api/*": ["./src/frontend/api/*"],
      "@cfreact-template/main/frontend/domain": ["./src/__forbidden__/domain.ts"],
      "@cfreact-template/main/frontend/domain/*": ["./src/__forbidden__/domain/*"],
      "@cfreact-template/ui": ["./src/__forbidden__/ui.ts"],
      "@cfreact-template/ui/*": ["./src/__forbidden__/ui/*"]
    }
  },
  "include": ["src/frontend/api/**/*", "orval.frontend.config.ts"]
}
